{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kryo Shard",
  "mainBinaryName": "kryo-shard",
  "version": "0.1.0",
  "identifier": "com.kryostudio.kryoshard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Kryo Shard",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#0B1020",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Kryo Studio",
    "copyright": "Copyright (C) 2026 Kryo Studio. GPL-3.0-only.",
    "category": "Video",
    "shortDescription": "Free, open-source game clipping for Windows.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
